# ── Required ───────────────────────────────────────────────────────────────
# Discord bot token — https://discord.com/developers/applications
DISCORD_TOKEN=
# Discord application ID (General Information -> Application ID)
DISCORD_CLIENT_ID=
# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ── Storage ────────────────────────────────────────────────────────────────
# SQLite database + audio cache location. Must match the Railway Volume mount.
DATA_DIR=/data
# HTTP port for the Railway health endpoint (/health)
PORT=8080

# ── Optional: Spotify support ──────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Optional: tuning ───────────────────────────────────────────────────────
# CACHE_LIMIT=2GB
# ENABLE_SPONSORBLOCK=true
# SPONSORBLOCK_TIMEOUT=5
# YT_DLP_AUTO_UPDATE=true

# ── Optional: presence ─────────────────────────────────────────────────────
# BOT_STATUS=online
# BOT_ACTIVITY_TYPE=LISTENING
# BOT_ACTIVITY=music
# BOT_ACTIVITY_URL=
