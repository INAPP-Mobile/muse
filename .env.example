# ============================================================
# Muse Discord music bot — environment variables
# Single service: muse (Discord bot + health sidecar)
# All required vars must be set for the bot to function.
# ============================================================

# --- Required ---

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Discord application client ID (from Discord Developer Portal)
DISCORD_CLIENT_ID=

# Discord application client secret (from Discord Developer Portal)
DISCORD_CLIENT_SECRET=

# YouTube API key (from https://console.developers.google.com/)
YOUTUBE_API_KEY=

# --- Optional ---

# Container timezone (IANA name)
TZ=UTC

# Spotify integration (optional — enables Spotify URL conversion)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Bot status (online, dnd, idle, invisible)
# BOT_STATUS=

# Bot activity type (PLAYING, STREAMING, LISTENING, WATCHING, COMPETING)
# BOT_ACTIVITY_TYPE=

# Bot activity text (shown in sidebar)
# BOT_ACTIVITY=

# YouTube-DLP auto-update (true/false, default: true)
# YT_DLP_AUTO_UPDATE=true

# Cache limit (e.g., 2GB)
# CACHE_LIMIT=2GB

# Enable SponsorBlock (true/false)
# ENABLE_SPONSORBLOCK=true

# Data directory (default: /data, should match volume mount)
DATA_DIR=/data
